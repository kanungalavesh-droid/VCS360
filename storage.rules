rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Blog cover images generated by Gemini: publicly readable (they're
    // shown on the public blog pages), writable only by the Admin SDK
    // (the generator scripts), which bypasses these rules entirely.
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
