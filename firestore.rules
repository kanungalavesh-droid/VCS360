rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these signed-in emails count as admin, even if another Firebase
    // Auth account somehow exists — a valid session alone isn't enough.
    function isAdminEmail() {
      return request.auth != null &&
        request.auth.token.email in [
          'kanunga.lavesh@gmail.com'
        ];
    }

    // Public lead form: anyone can submit a lead, nobody can read/edit/delete
    // them from the client. View leads via the Firebase console instead.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0;
      allow read, update, delete: if false;
    }

    // Blog posts: public can read published posts only. Full read/write
    // access requires being one of the whitelisted admin emails above.
    // The automated generator script uses the Admin SDK with a service
    // account, which bypasses these rules entirely.
    match /blogs/{blogId} {
      allow read: if resource.data.published == true || isAdminEmail();
      allow create, update, delete: if isAdminEmail();
    }
  }
}
